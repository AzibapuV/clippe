# AI clip detection (Phase 4)
# Transcription — https://www.assemblyai.com
ASSEMBLYAI_API_KEY="your-assemblyai-api-key"
# LLM that finds clip-worthy moments in the transcript — https://console.anthropic.com
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional — defaults to claude-sonnet-5 if not set
CLAUDE_MODEL="claude-sonnet-5"

# Optional — override the Claude API endpoint (e.g. to point at a
# compatible proxy instead of real Anthropic). Leave unset to use the
# real Anthropic API.
CLAUDE_API_BASE_URL=""
