# Postgres connection string.
# On Render: create a Postgres instance, then copy its "Internal Database URL" here.
DATABASE_URL="postgresql://user:password@localhost:5432/clippers_creator"

# NextAuth
# Generate a secret locally with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# The public URL of your deployed app (Render gives you this after first deploy)
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google sign-in (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
